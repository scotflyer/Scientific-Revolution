{
  "name": "desktop-app",
  "version": "0.1.0",
  "description": "科学革命 U 盘电子出版物桌面阅读器",
  "author": "胡晓辉",
  "private": true,
  "type": "module",
  "main": "electron/main.mjs",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 4173 --strictPort",
    "build": "tsc --noEmit && vite build && node scripts/prepare-sites-build.mjs",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview",
    "test:sites": "node --test tests/sites-worker.test.mjs",
    "dev:desktop": "node scripts/start-desktop.mjs --dev",
    "build:desktop": "tsc --noEmit && vite build --config vite.desktop.config.mjs && node scripts/prepare-desktop-build.mjs",
    "start:desktop": "node scripts/start-desktop.mjs",
    "test:desktop": "node --test tests/desktop-runtime.test.mjs",
    "verify:desktop": "node scripts/verify-desktop.mjs",
    "package:windows": "node scripts/package-release.mjs windows",
    "package:mac": "node scripts/package-release.mjs mac",
    "prepare:publication": "node scripts/prepare-publication.mjs"
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "5.0.4",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "typescript": "^7.0.2",
    "vite": "6.4.2"
  },
  "devDependencies": {
    "electron": "38.8.6",
    "electron-builder": "26.15.3",
    "playwright": "^1.64.1"
  }
}
